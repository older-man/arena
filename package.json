{
  "name": "local-mcp-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist/desktop/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && tsc -p extension/tsconfig.json && node scripts/build.mjs",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "desktop": "npm run build && electron .",
    "test": "tsx --test tests/*.test.ts",
    "simulate": "tsx scripts/simulate.ts"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.310",
    "@types/node": "^22.13.10",
    "electron": "^39.8.10",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
